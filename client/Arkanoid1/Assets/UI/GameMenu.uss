/* GameMenu.uss - Simple Flex Layout */
.menuContainer {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    justify-content: center;
    align-items: center;
}

.panel {
    width: 80%;
    max-width: 360px;
    margin-top: 15%;
    padding-top: 35px;
    padding-bottom: 35px;
    padding-left: 28px;
    padding-right: 28px;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(180deg, rgba(255,255,255,0.97) 0%, rgba(248,245,255,0.98) 100%);
    border: 4px solid #ffd93d;
    border-radius: 22px;
    box-shadow: 0 0 45px rgba(255,217,61,0.4), 0 12px 35px rgba(0,0,0,0.4);
}

.panel {
    width: 80%;
    max-width: 360px;
    padding-top: 35px;
    padding-bottom: 35px;
    padding-left: 28px;
    padding-right: 28px;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(180deg, rgba(255,255,255,0.97) 0%, rgba(248,245,255,0.98) 100%);
    border: 4px solid #ffd93d;
    border-radius: 22px;
    box-shadow: 0 0 45px rgba(255,217,61,0.4), 0 12px 35px rgba(0,0,0,0.4);
}

.hiddenPanel {
    display: none;
}

.titleLabel {
    font-size: 38px;
    margin-bottom: 10px;
    color: #ff6b6b;
    -unity-font-style: bold;
    unity-text-align: middle-center;
    align-self: center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255,107,107,0.5);
}

.subtitleLabel {
    font-size: 15px;
    margin-bottom: 24px;
    color: #6c5ce7;
    unity-text-align: middle-center;
    align-self: center;
}

.primaryButton {
    width: 100%;
    height: 65px;
    margin-bottom: 14px;
    background: linear-gradient(90deg, #ff6b6b 0%, #ffb347 100%);
    border: none;
    border-radius: 18px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    box-shadow: 0 6px 22px rgba(255,107,107,0.4);
}

.primaryButton:hover {
    transform: scale(1.02);
}

.secondaryButton {
    width: 100%;
    height: 55px;
    margin-top: 14px;
    background: linear-gradient(180deg, #b4a7ff 0%, #7c6ecf 100%);
    border: none;
    border-radius: 16px;
    color: white;
    font-size: 17px;
}

.secondaryButton:hover {
    transform: scale(1.01);
}

.partnerTitle {
    font-size: 26px;
    margin-bottom: 8px;
    color: #00d4ff;
    -unity-font-style: bold;
    unity-text-align: middle-center;
    align-self: center;
}

.partnerSubtitleLabel {
    font-size: 14px;
    margin-bottom: 18px;
    color: #557799;
    unity-text-align: middle-center;
    align-self: center;
}

.createRoomButton {
    background: linear-gradient(90deg, #00d4ff 0%, #00e5b8 100%);
}

.roomCodeLabel {
    margin-top: 18px;
    margin-bottom: 10px;
    color: #fd79a8;
    font-size: 20px;
    -unity-font-style: bold;
    unity-text-align: middle-center;
    align-self: center;
}

.roomCodeField {
    width: 100%;
    height: 55px;
    margin-bottom: 14px;
    background: #f0f9ff;
    border: 3px solid #7dd3fc;
    border-radius: 14px;
    color: #1b263b;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    align-self: stretch;
}

.roomCodeField:focus {
    border-color: #00d4ff;
    box-shadow: 0 0 16px rgba(0,212,255,0.35);
}

.joinRoomButton {
    background: linear-gradient(90deg, #b366ff 0%, #ff6b9d 100%);
}

.statusLabel {
    margin-top: 14px;
    color: #6c5ce7;
    font-size: 14px;
    unity-text-align: middle-center;
    align-self: center;
}