.container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 48px;
    padding-right: 48px;
    background-color: rgb(16, 24, 34);
}

.panel {
    width: 360px;
    align-items: stretch;
}

.hiddenPanel {
    display: none;
}

.title {
    margin-bottom: 16px;
    color: rgb(255, 208, 110);
    font-size: 40px;
    -unity-font-style: bold;
    unity-text-align: middle-center;
}

.subtitle {
    margin-bottom: 28px;
    color: rgb(214, 224, 234);
    font-size: 18px;
    unity-text-align: middle-center;
}

.primaryButton {
    width: 100%;
    height: 52px;
    margin-bottom: 14px;
    color: rgb(20, 20, 20);
    background-color: rgb(255, 208, 110);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 20px;
    -unity-font-style: bold;
}

.secondaryButton {
    width: 100%;
    height: 48px;
    margin-top: 6px;
    color: rgb(240, 242, 245);
    background-color: rgb(52, 72, 92);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 18px;
}

.roomCodeLabel {
    margin-top: 8px;
    margin-bottom: 12px;
    color: rgb(255, 208, 110);
    font-size: 24px;
    -unity-font-style: bold;
    unity-text-align: middle-center;
}

.roomCodeField {
    margin-bottom: 14px;
    color: rgb(240, 242, 245);
}

.statusLabel {
    margin-top: 12px;
    margin-bottom: 6px;
    color: rgb(214, 224, 234);
    font-size: 16px;
    unity-text-align: middle-center;
    white-space: normal;
}
