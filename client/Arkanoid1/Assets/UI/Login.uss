/* Login.uss - Simple Flex Layout */
.loginContainer {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1a0533 0%, #4a1259 50%, #2d1b4e 100%);
    justify-content: center;
    align-items: center;
}

.loginPanel {
    width: 80%;
    max-width: 340px;
    margin-top: 15%;
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 25px;
    padding-right: 25px;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(180deg, rgba(255,255,255,0.97) 0%, rgba(248,240,255,0.98) 100%);
    border: 4px solid #ff6b9d;
    border-radius: 22px;
    box-shadow: 0 0 40px rgba(255,107,157,0.4), 0 10px 30px rgba(0,0,0,0.4);
}

.loginPanel {
    width: 80%;
    max-width: 340px;
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 25px;
    padding-right: 25px;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(180deg, rgba(255,255,255,0.97) 0%, rgba(248,240,255,0.98) 100%);
    border: 4px solid #ff6b9d;
    border-radius: 22px;
    box-shadow: 0 0 40px rgba(255,107,157,0.4), 0 10px 30px rgba(0,0,0,0.4);
}

.titleLabel {
    font-size: 38px;
    margin-bottom: 10px;
    color: #ff6b9d;
    -unity-font-style: bold;
    unity-text-align: middle-center;
    align-self: center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(255,107,157,0.5);
}

.subtitleLabel {
    font-size: 16px;
    margin-bottom: 22px;
    color: #8866aa;
    unity-text-align: middle-center;
    align-self: center;
}

.inputContainer {
    margin-bottom: 14px;
    align-self: stretch;
}

.inputLabel {
    font-size: 14px;
    margin-bottom: 5px;
    color: #ff6b9d;
    -unity-font-style: bold;
}

.inputField {
    width: 100%;
    height: 55px;
    background: linear-gradient(180deg, #fff5f8 0%, #ffeef2 100%);
    border: 3px solid #ffb6d9;
    border-radius: 14px;
    color: #4a1259;
    font-size: 18px;
    padding-left: 14px;
    align-self: stretch;
}

.inputField:focus {
    border-color: #ff6b9d;
    box-shadow: 0 0 18px rgba(255,107,157,0.4);
}

.loginButton {
    width: 100%;
    height: 65px;
    margin-top: 22px;
    background: linear-gradient(90deg, #ff6b9d 0%, #ff8a5c 100%);
    border: none;
    border-radius: 18px;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    box-shadow: 0 6px 22px rgba(255,107,157,0.5);
}

.registerRow {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 22px;
    align-self: center;
}

.registerPrompt {
    color: #8866aa;
    font-size: 15px;
}

.registerButton {
    color: #ff6b9d;
    font-size: 15px;
    -unity-font-style: bold;
    background: none;
    border: none;
    margin-left: 5px;
}

.statusLabel {
    margin-top: 16px;
    font-size: 13px;
    color: #ff4757;
    unity-text-align: middle-center;
    align-self: center;
}