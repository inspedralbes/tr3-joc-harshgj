/* Register.uss - Simple Flex Layout */
.registerContainer {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #0d1b2a 0%, #1b263b 50%, #415a77 100%);
    justify-content: center;
    align-items: center;
}

.registerPanel {
    width: 80%;
    max-width: 320px;
    margin-top: 15%;
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 25px;
    padding-right: 25px;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(180deg, rgba(255,255,255,0.97) 0%, rgba(248,248,255,0.98) 100%);
    border: 4px solid #00d4ff;
    border-radius: 22px;
    box-shadow: 0 0 40px rgba(0,212,255,0.4), 0 10px 30px rgba(0,0,0,0.4);
}

.registerPanel {
    width: 80%;
    max-width: 320px;
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 25px;
    padding-right: 25px;
    flex-direction: column;
    align-items: stretch;
    background: linear-gradient(180deg, rgba(255,255,255,0.97) 0%, rgba(248,248,255,0.98) 100%);
    border: 4px solid #00d4ff;
    border-radius: 22px;
    box-shadow: 0 0 40px rgba(0,212,255,0.4), 0 10px 30px rgba(0,0,0,0.4);
}

.titleLabel {
    font-size: 36px;
    margin-bottom: 10px;
    color: #00d4ff;
    -unity-font-style: bold;
    unity-text-align: middle-center;
    align-self: center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0,212,255,0.5);
}

.subtitleLabel {
    font-size: 15px;
    margin-bottom: 20px;
    color: #557799;
    unity-text-align: middle-center;
    align-self: center;
}

.inputContainer {
    margin-bottom: 12px;
    align-self: stretch;
}

.inputLabel {
    font-size: 13px;
    margin-bottom: 4px;
    color: #00d4ff;
    -unity-font-style: bold;
}

.inputField {
    width: 100%;
    height: 52px;
    background: linear-gradient(180deg, #f0f9ff 0%, #e5f5ff 100%);
    border: 3px solid #7dd3fc;
    border-radius: 14px;
    color: #1b263b;
    font-size: 17px;
    padding-left: 14px;
    align-self: stretch;
}

.inputField:focus {
    border-color: #00d4ff;
    box-shadow: 0 0 18px rgba(0,212,255,0.4);
}

.registerButton {
    width: 100%;
    height: 65px;
    margin-top: 22px;
    background: linear-gradient(90deg, #00d4ff 0%, #00e5b8 100%);
    border: none;
    border-radius: 18px;
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    box-shadow: 0 6px 22px rgba(0,212,255,0.5);
}

.backButton {
    width: 100%;
    height: 55px;
    margin-top: 14px;
    background: linear-gradient(180deg, #e8ebff 0%, #d8dcf5 100%);
    border: 3px solid #a5b4fc;
    border-radius: 14px;
    color: #557799;
    font-size: 17px;
}

.statusLabel {
    margin-top: 16px;
    font-size: 12px;
    color: #ff4757;
    unity-text-align: middle-center;
    align-self: center;
    min-height: 20px;
}