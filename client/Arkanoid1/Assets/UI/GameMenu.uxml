<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="menuContainer" class="menuContainer">
        <ui:VisualElement name="mainMenuPanel" class="panel">
            <ui:Label name="titleLabel" text="🎮 ARKANOID 🎮" class="titleLabel" />
            <ui:Label name="subtitleLabel" text="Choose your adventure!" class="subtitleLabel" />
            <ui:Button name="soloPlayButton" text="⚡ Solo Mode" class="primaryButton" />
            <ui:Button name="partnerPlayButton" text="👥 With Friend" class="primaryButton" />
            <ui:Button name="aiPlayButton" text="🤖 With AI" class="primaryButton" />
            <ui:Button name="backButton" text="⬅️ Login" class="secondaryButton" />
        </ui:VisualElement>

        <ui:VisualElement name="partnerLobbyPanel" class="panel hiddenPanel">
            <ui:Label text="👥 Partner Lobby" class="partnerTitle" />
            <ui:Label name="partnerSubtitleLabel" text="Play together!" class="partnerSubtitleLabel" />
            <ui:Button name="createRoomButton" text="➕ Create Room" class="primaryButton createRoomButton" />
            <ui:Label name="roomCodeLabel" text="Room Code" class="roomCodeLabel" />
            <ui:TextField name="roomCodeField" class="roomCodeField" />
            <ui:Button name="joinRoomButton" text="🚪 Join Room" class="primaryButton joinRoomButton" />
            <ui:Label name="partnerStatusLabel" text="Ready to play!" class="statusLabel" />
            <ui:Button name="partnerBackButton" text="⬅️ Back" class="secondaryButton" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>